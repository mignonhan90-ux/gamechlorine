  <script>
    /* HỆ THỐNG ÂM THANH NỘI TUYẾN WEB AUDIO API ĐẦY ĐỦ */
    let audioCtx = null;
    let isSoundMuted = false;

    function initAudio() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function toggleSound() {
      isSoundMuted = !isSoundMuted;
      document.getElementById('sound-icon').textContent = isSoundMuted ? '🔇' : '🔊';
      document.getElementById('sound-text').textContent = isSoundMuted ? 'ĐÃ TẮT' : 'ÂM THANH';
    }

    function playTone(freq, duration, type = 'sine', gainVal = 0.15) {
      if (isSoundMuted) return;
      try {
        initAudio();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(gainVal, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    /* BỘ ÂM THANH TIMER VÀ HIỆU ỨNG GAME CHI TIẾT */
    const SoundFX = {
      start: () => {
        playTone(392, 0.1, 'triangle', 0.2);
        setTimeout(() => playTone(523.25, 0.12, 'triangle', 0.25), 100);
        setTimeout(() => playTone(659.25, 0.25, 'sine', 0.3), 220);
      },
      cardClick: () => playTone(587.33, 0.08, 'sine', 0.15),
      
      // Âm Tick điện tử đếm giây (10 -> 4)
      clockTick: () => {
        if (isSoundMuted) return;
        try {
          initAudio();
          const t = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(950, t);
          osc.frequency.exponentialRampToValueAtTime(350, t + 0.06);
          gain.gain.setValueAtTime(0.22, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(t);
          osc.stop(t + 0.06);
        } catch(e) {}
      },

      // Giây 3: Beep vàng
      beep3: () => {
        if (isSoundMuted) return;
        try {
          initAudio();
          const t = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(587, t);
          gain.gain.setValueAtTime(0.25, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(t);
          osc.stop(t + 0.18);
        } catch(e) {}
      },

      // Giây 2: Beep cam khẩn trương hơn
      beep2: () => {
        if (isSoundMuted) return;
        try {
          initAudio();
          const t = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(740, t);
          gain.gain.setValueAtTime(0.3, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(t);
          osc.stop(t + 0.2);
        } catch(e) {}
      },

      // Giây 1: Beep đỏ báo động dồn dập
      beep1: () => {
        if (isSoundMuted) return;
        try {
          initAudio();
          const t = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(988, t);
          gain.gain.setValueAtTime(0.35, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(t);
          osc.stop(t + 0.22);
        } catch(e) {}
      },

      // Giây 0: Âm BEEEEEP dài kết thúc thời gian
      timeUpBeeeeep: () => {
        if (isSoundMuted) return;
        try {
          initAudio();
          const t = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(392, t);
          osc.frequency.setValueAtTime(370, t + 0.25);
          gain.gain.setValueAtTime(0.35, t);
          gain.gain.setValueAtTime(0.35, t + 0.6);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.75);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(t);
          osc.stop(t + 0.75);
        } catch(e) {}
      },

      correctDing: () => {
        playTone(523.25, 0.12, 'sine', 0.25);
        setTimeout(() => playTone(659.25, 0.2, 'sine', 0.3), 120);
      },
      wrongBuzz: () => playTone(146.83, 0.25, 'sawtooth', 0.25),
      unlockData: () => {
        playTone(523.25, 0.1, 'triangle', 0.25);
        setTimeout(() => playTone(659.25, 0.1, 'triangle', 0.25), 90);
        setTimeout(() => playTone(783.99, 0.12, 'triangle', 0.25), 180);
        setTimeout(() => playTone(1046.5, 0.3, 'sine', 0.3), 270);
      },
      dingDingFull: () => {
        playTone(659.25, 0.2, 'triangle', 0.3);
        setTimeout(() => playTone(880, 0.2, 'triangle', 0.3), 150);
        setTimeout(() => playTone(1046.5, 0.4, 'sine', 0.35), 300);
      },
      special: () => {
        playTone(440, 0.1, 'square', 0.2);
        setTimeout(() => playTone(554.37, 0.1, 'square', 0.2), 100);
        setTimeout(() => playTone(659.25, 0.2, 'square', 0.2), 200);
      },
      victory: () => {
        [523.25, 659.25, 783.99, 1046.5].forEach((f, idx) => {
          setTimeout(() => playTone(f, 0.25, 'triangle', 0.28), idx * 140);
        });
      }
    };

    /* HÀM SCALE 16:9 CHUẨN CỐ ĐỊNH */
    function fitGameToScreen() {
      const sw = window.innerWidth;
      const sh = window.innerHeight;
      const scale = Math.min(sw / 1920, sh / 1080);
      const stage = document.getElementById('game-stage');
      if (stage) {
        stage.style.transform = `scale(${scale})`;
      }
    }

    window.addEventListener('load', fitGameToScreen);
    window.addEventListener('resize', fitGameToScreen);
    window.addEventListener('orientationchange', fitGameToScreen);
    document.addEventListener('fullscreenchange', () => {
      setTimeout(fitGameToScreen, 150);
    });

    function toggleFullScreen() {
      const wrapper = document.getElementById('screen-wrapper');
      if (!document.fullscreenElement) {
        if (wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (wrapper.webkitRequestFullscreen) {
          wrapper.webkitRequestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
      setTimeout(fitGameToScreen, 150);
    }

