<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>AI Cl-17: KHO DỮ LIỆU BÍ MẬT - ỨNG DỤNG CỦA CHLORINE</title>
  <style>
    /* KHÓA GIAO DIỆN 16:9 KHÔNG CUỘN, CĂN TÂM TUYỆT ĐỐI */
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #020713;
      font-family: 'Segoe UI', Arial, Tahoma, sans-serif;
      user-select: none;
      -webkit-user-select: none;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-dark: #040e29;
      --cyan-bright: #00e5ff;
      --cyan-glow: rgba(0, 229, 255, 0.4);
      --gold-bright: #ffaa00;
      --team1-red: #ff334b;
      --team2-blue: #00b0ff;
      --team3-gold: #ffc400;
      --team4-green: #00e676;
    }

    #screen-wrapper {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: radial-gradient(circle at center, #071536 0%, #020712 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #game-stage {
      position: relative;
      width: 1920px;
      height: 1080px;
      flex-shrink: 0;
      transform-origin: center center;
      background: radial-gradient(circle at 50% 30%, #0e2454 0%, #071330 60%, #040a1c 100%);
      overflow: hidden;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.95);
      border-radius: 4px;
    }

    /* Nền phòng lab tương lai tĩnh */
    .lab-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      pointer-events: none;
      z-index: 1;
    }
    .lab-ceiling {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 110px;
      background: linear-gradient(180deg, #101c3d 0%, #0b1530 60%, transparent 100%);
      border-bottom: 2px solid rgba(0, 229, 255, 0.25);
    }
    .lab-floor {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 310px;
      background: linear-gradient(0deg, #071026 0%, #0b1a3d 40%, rgba(9, 23, 54, 0.3) 100%);
      border-top: 2px solid rgba(0, 229, 255, 0.2);
      transform: perspective(600px) rotateX(15deg);
      transform-origin: bottom center;
    }
    .lab-floor-lines {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        repeating-linear-gradient(90deg, rgba(0, 229, 255, 0.04) 0px, rgba(0, 229, 255, 0.04) 2px, transparent 2px, transparent 160px),
        repeating-linear-gradient(0deg, rgba(0, 229, 255, 0.04) 0px, rgba(0, 229, 255, 0.04) 2px, transparent 2px, transparent 60px);
    }

    /* Nút chức năng góc trên */
    .top-controls {
      position: absolute;
      top: 22px;
      right: 35px;
      z-index: 40;
      display: flex;
      gap: 14px;
    }
    .ctrl-btn {
      background: linear-gradient(180deg, #1a3262, #0d1e3d);
      border: 2px solid #3877cc;
      color: #e1f0ff;
      padding: 9px 20px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .ctrl-btn:hover {
      border-color: var(--cyan-bright);
      box-shadow: 0 0 15px var(--cyan-glow);
      color: #fff;
    }
    .ctrl-btn:active {
      transform: scale(0.96);
    }

    /* Logo AI Cl-17 */
    .brand-container {
      position: absolute;
      top: 20px;
      left: 40px;
      z-index: 20;
    }
    .brand-frame {
      background: linear-gradient(135deg, rgba(14, 34, 76, 0.95), rgba(7, 18, 43, 0.98));
      border: 3px solid #2968ba;
      border-radius: 18px;
      padding: 10px 32px 12px 32px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 160, 255, 0.3), inset 0 0 15px rgba(0, 229, 255, 0.2);
      text-align: center;
      position: relative;
    }
    .brand-frame::before {
      content: "";
      position: absolute;
      top: -5px;
      left: 20%;
      right: 20%;
      height: 4px;
      background: #00e5ff;
      border-radius: 4px;
      box-shadow: 0 0 10px #00e5ff;
    }
    .title-ai {
      font-size: 38px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #ffffff;
      text-shadow: 0 0 10px #00c8ff, 0 3px 0 #1b4d8a, 0 6px 12px rgba(0,0,0,0.8);
    }
    .title-kho {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 1.5px;
      background: linear-gradient(180deg, #fff7b3 0%, #ffc800 45%, #ff7700 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 5px rgba(0,0,0,0.8)) drop-shadow(0 0 10px rgba(255, 160, 0, 0.5));
      margin-top: -2px;
    }
    .title-sub {
      margin-top: 6px;
      background: rgba(0, 140, 255, 0.25);
      border: 1.5px solid #00c8ff;
      border-radius: 8px;
      padding: 3px 16px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 2px;
      color: #e0f7ff;
      text-shadow: 0 0 8px rgba(0, 229, 255, 0.8);
    }

    /* Scoreboard 4 Nhóm */
    .scoreboard-row {
      position: absolute;
      top: 22px;
      left: 540px;
      z-index: 20;
      display: flex;
      gap: 20px;
    }
    .team-card {
      width: 172px;
      background: linear-gradient(180deg, #102142 0%, #091326 100%);
      border: 3px solid #204172;
      border-radius: 14px;
      padding: 8px 10px 10px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
      position: relative;
      transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    .team-card.team-1 { border-color: #7a1b28; }
    .team-card.team-2 { border-color: #164e8a; }
    .team-card.team-3 { border-color: #87650d; }
    .team-card.team-4 { border-color: #126338; }

    .team-card.active-turn {
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.8), 0 0 35px var(--cyan-bright);
      transform: translateY(-4px);
    }
    .team-card.team-1.active-turn { border-color: var(--team1-red); box-shadow: 0 0 25px var(--team1-red); }
    .team-card.team-2.active-turn { border-color: var(--team2-blue); box-shadow: 0 0 25px var(--team2-blue); }
    .team-card.team-3.active-turn { border-color: var(--team3-gold); box-shadow: 0 0 25px var(--team3-gold); }
    .team-card.team-4.active-turn { border-color: var(--team4-green); box-shadow: 0 0 25px var(--team4-green); }

    .team-avatar-box {
      width: 140px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 4px;
    }
    .team-badge-header {
      width: 100%;
      border-radius: 6px;
      padding: 4px 0;
      text-align: center;
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }
    .team-1 .team-badge-header { background: linear-gradient(180deg, #d32f2f, #9a0007); }
    .team-2 .team-badge-header { background: linear-gradient(180deg, #0288d1, #005b9f); }
    .team-3 .team-badge-header { background: linear-gradient(180deg, #f57f17, #bc5100); }
    .team-4 .team-badge-header { background: linear-gradient(180deg, #2e7d32, #1b5e20); }

    .team-led-score {
      width: 100%;
      background: #030813;
      border: 2px solid #1a325c;
      border-radius: 8px;
      padding: 5px 0;
      text-align: center;
      font-size: 36px;
      font-weight: 900;
      font-family: 'Courier New', Courier, monospace;
      color: #00ffcc;
      text-shadow: 0 0 10px rgba(0, 255, 204, 0.7);
    }
    .team-1 .team-led-score { color: #ff6b7e; text-shadow: 0 0 10px rgba(255, 80, 100, 0.7); }
    .team-2 .team-led-score { color: #4dc2ff; text-shadow: 0 0 10px rgba(77, 194, 255, 0.7); }
    .team-3 .team-led-score { color: #ffeb3b; text-shadow: 0 0 10px rgba(255, 235, 59, 0.7); }
    .team-4 .team-led-score { color: #69f0ae; text-shadow: 0 0 10px rgba(105, 240, 174, 0.7); }

    .team-adjust-row {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin-top: 6px;
      gap: 6px;
    }
    .adj-btn {
      flex: 1;
      background: #142340;
      border: 1px solid #2a4c7e;
      color: #9bb7dd;
      font-size: 13px;
      font-weight: bold;
      padding: 3px 0;
      border-radius: 5px;
      cursor: pointer;
    }
    .adj-btn:hover { background: #1f3766; color: #fff; }

    /* Thanh thông báo lượt chơi */
    .turn-status-banner {
      position: absolute;
      top: 195px;
      left: 540px;
      width: 748px;
      height: 42px;
      background: linear-gradient(90deg, rgba(8, 25, 60, 0.85), rgba(12, 40, 95, 0.95), rgba(8, 25, 60, 0.85));
      border: 2px solid #2669ba;
      border-radius: 21px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5), 0 0 15px rgba(0, 160, 255, 0.2);
    }
    .turn-status-text {
      font-size: 19px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #e6f6ff;
      text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
    }

    /* Vị trí Robot Cl-17 */
    .robot-area {
      position: absolute;
      bottom: 55px;
      left: 45px;
      width: 420px;
      height: 640px;
      z-index: 15;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
    }
    .robot-svg-container {
      width: 400px;
      height: 510px;
      filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.7));
    }
    .robot-podium {
      width: 320px;
      height: 46px;
      background: radial-gradient(ellipse at center, rgba(0, 229, 255, 0.6) 0%, rgba(0, 140, 255, 0.3) 50%, transparent 80%);
      border-radius: 50%;
      margin-top: -23px;
      box-shadow: 0 0 35px rgba(0, 229, 255, 0.6);
      border: 2px solid rgba(0, 229, 255, 0.4);
    }

    /* Lưới 12 thẻ (2 hàng x 6 cột) cố định */
    .cards-grid-container {
      position: absolute;
      top: 252px;
      left: 480px;
      width: 1400px;
      height: 630px;
      z-index: 20;
      display: grid;
      grid-template-columns: repeat(6, 212px);
      grid-template-rows: repeat(2, 290px);
      gap: 28px 24px;
      justify-content: center;
    }
    .game-card {
      position: relative;
      width: 212px;
      height: 290px;
      background: linear-gradient(160deg, #0e244d 0%, #081631 55%, #050f24 100%);
      border: 3px solid #3c7cd0;
      border-radius: 18px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7), inset 0 0 20px rgba(0, 140, 255, 0.25);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 12px 10px 18px 10px;
      transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      overflow: hidden;
    }
    .game-card:hover:not(.opened):not(.disabled) {
      transform: translateY(-8px);
      border-color: #00e5ff;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 229, 255, 0.5);
    }
    .game-card.disabled {
      cursor: not-allowed;
      filter: brightness(0.7);
    }
    .game-card.opened {
      cursor: default;
      background: linear-gradient(160deg, #08152e 0%, #040c1a 100%);
      border-color: #244b7a;
      box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.9);
    }

    .card-num-badge {
      width: 86px;
      height: 36px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: 900;
      color: #ffffff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.8);
      box-shadow: 0 4px 10px rgba(0,0,0,0.5), inset 0 1px 2px rgba(255,255,255,0.4);
      z-index: 2;
    }
    .card-c1 .card-num-badge { background: linear-gradient(180deg, #e53935, #b71c1c); border: 2px solid #ff7961; }
    .card-c2 .card-num-badge { background: linear-gradient(180deg, #0288d1, #01579b); border: 2px solid #4fc3f7; }
    .card-c3 .card-num-badge { background: linear-gradient(180deg, #f57f17, #e65100); border: 2px solid #ffb74d; }
    .card-c4 .card-num-badge { background: linear-gradient(180deg, #2e7d32, #1b5e20); border: 2px solid #81c784; }
    .card-c5 .card-num-badge { background: linear-gradient(180deg, #e53935, #b71c1c); border: 2px solid #ff7961; }
    .card-c6 .card-num-badge { background: linear-gradient(180deg, #0288d1, #01579b); border: 2px solid #4fc3f7; }
    .card-c7 .card-num-badge { background: linear-gradient(180deg, #f57f17, #e65100); border: 2px solid #ffb74d; }
    .card-c8 .card-num-badge { background: linear-gradient(180deg, #2e7d32, #1b5e20); border: 2px solid #81c784; }
    .card-c9 .card-num-badge { background: linear-gradient(180deg, #e53935, #b71c1c); border: 2px solid #ff7961; }
    .card-c10 .card-num-badge { background: linear-gradient(180deg, #0288d1, #01579b); border: 2px solid #4fc3f7; }
    .card-c11 .card-num-badge { background: linear-gradient(180deg, #f57f17, #e65100); border: 2px solid #ffb74d; }
    .card-c12 .card-num-badge { background: linear-gradient(180deg, #2e7d32, #1b5e20); border: 2px solid #81c784; }

    .card-center-circle {
      position: relative;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 3px solid #1e5ba3;
      background: radial-gradient(circle, #0e2f63 0%, #081735 80%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 0 15px rgba(0, 229, 255, 0.4), 0 0 15px rgba(0, 140, 255, 0.25);
    }
    .card-qmark {
      font-size: 80px;
      font-weight: 900;
      background: linear-gradient(180deg, #fff3a8 0%, #ffb800 45%, #ff7700 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 4px 6px rgba(0,0,0,0.8));
    }
    .card-tech-lines {
      width: 80%;
      height: 12px;
      display: flex;
      justify-content: center;
      gap: 6px;
    }
    .tech-pill {
      width: 24px;
      height: 5px;
      background: #194680;
      border-radius: 3px;
    }
    .game-card.opened .card-center-circle {
      border-color: #1a385f;
      background: #081224;
    }
    .game-card.opened .card-qmark { display: none; }
    .card-check-icon {
      display: none;
      font-size: 64px;
      color: #00e676;
      filter: drop-shadow(0 0 10px rgba(0, 230, 118, 0.7));
    }
    .game-card.opened .card-check-icon { display: block; }

    /* Thanh Dữ liệu đáy màn hình */
    .data-bar-footer {
      position: absolute;
      bottom: 22px;
      left: 480px;
      width: 1400px;
      height: 104px;
      background: linear-gradient(180deg, rgba(13, 31, 71, 0.95) 0%, rgba(6, 17, 41, 0.98) 100%);
      border: 3px solid #235fa7;
      border-radius: 16px;
      padding: 10px 24px;
      z-index: 20;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.8), inset 0 0 15px rgba(0, 229, 255, 0.15);
    }
    .data-bar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .data-bar-title {
      font-size: 19px;
      font-weight: 800;
      color: #8acaff;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 1px;
    }
    .data-bar-count {
      font-size: 20px;
      font-weight: 900;
      color: #00ffcc;
      background: #040c1e;
      padding: 2px 14px;
      border-radius: 12px;
      border: 1.5px solid #00c8ff;
    }
    .data-slots-row {
      display: flex;
      gap: 14px;
      width: 100%;
      height: 52px;
    }
    .data-slot-item {
      flex: 1;
      background: #07142e;
      border: 2px dashed #1d4b88;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 10px;
      text-align: center;
      font-size: 15px;
      font-weight: 800;
      color: #5d84b8;
      letter-spacing: 0.5px;
      transition: background 0.3s, border-color 0.3s, color 0.3s;
    }
    .data-slot-item.unlocked {
      background: linear-gradient(90deg, rgba(0, 160, 255, 0.25), rgba(0, 229, 255, 0.35));
      border: 2px solid #00e5ff;
      color: #ffffff;
      text-shadow: 0 0 8px rgba(0, 229, 255, 0.9);
      box-shadow: 0 0 15px rgba(0, 229, 255, 0.35);
    }

    /* Modal câu hỏi */
    .modal-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      background: rgba(2, 6, 17, 0.9);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .modal-card {
      width: 1340px;
      max-height: 960px;
      background: linear-gradient(180deg, #0e224e 0%, #071430 70%, #040d21 100%);
      border: 4px solid #2a73d1;
      border-radius: 24px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 40px rgba(0, 180, 255, 0.4);
      padding: 28px 45px 32px 45px;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .modal-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid rgba(0, 229, 255, 0.3);
      padding-bottom: 12px;
      margin-bottom: 18px;
    }
    .modal-task-title {
      font-size: 32px;
      font-weight: 900;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 16px;
      text-shadow: 0 0 12px rgba(0, 229, 255, 0.8);
    }
    .modal-card-badge {
      background: linear-gradient(180deg, #ff9100, #ff5722);
      padding: 6px 20px;
      border-radius: 12px;
      font-size: 20px;
      font-weight: 900;
      color: #fff;
    }

    .timer-control-box {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .timer-display {
      width: 80px;
      height: 52px;
      background: #020713;
      border: 2px solid #00e5ff;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      font-weight: 900;
      font-family: 'Courier New', Courier, monospace;
      color: #00e5ff;
      box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
      transition: all 0.2s ease;
    }
    .timer-display.warn-yellow { border-color: #ffd600; color: #ffd600; box-shadow: 0 0 20px rgba(255, 214, 0, 0.8); }
    .timer-display.warn-orange { border-color: #ff9100; color: #ff9100; box-shadow: 0 0 25px rgba(255, 145, 0, 0.85); }
    .timer-display.warn-red { border-color: #ff1744; color: #ff1744; box-shadow: 0 0 30px rgba(255, 23, 68, 0.95); }

    .btn-timer-start {
      background: linear-gradient(180deg, #0288d1, #01579b);
      border: 2px solid #4fc3f7;
      color: #fff;
      font-size: 18px;
      font-weight: 900;
      padding: 10px 24px;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    .btn-timer-start:disabled { opacity: 0.5; cursor: not-allowed; }

    .question-scenario-box {
      background: rgba(7, 21, 51, 0.85);
      border: 2px solid #23589b;
      border-radius: 16px;
      padding: 20px 26px;
      margin-bottom: 20px;
      box-shadow: inset 0 0 20px rgba(0,0,0,0.6);
    }
    .scenario-text {
      font-size: 26px;
      line-height: 1.5;
      color: #f0f7ff;
      font-weight: 700;
    }

    .answers-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px 24px;
      margin-bottom: 20px;
    }
    .answer-card {
      background: linear-gradient(180deg, #112854 0%, #091733 100%);
      border: 2px solid #2c65af;
      border-radius: 14px;
      padding: 15px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: all 0.2s ease;
    }
    .ans-badge {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: #183d73;
      border: 2px solid #488be6;
      color: #ffffff;
      font-size: 23px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .ans-content {
      font-size: 22px;
      font-weight: 700;
      color: #d8e9ff;
    }
    .answer-card.correct-highlight {
      border: 3px solid #00e676;
      background: linear-gradient(180deg, #0d442a 0%, #072b1a 100%);
      box-shadow: 0 0 25px rgba(0, 230, 118, 0.5);
    }
    .answer-card.correct-highlight .ans-badge {
      background: #00c853;
      border-color: #69f0ae;
    }
    .answer-card.wrong-fade {
      opacity: 0.35;
      filter: grayscale(0.6);
    }

    .grading-section {
      background: rgba(5, 14, 34, 0.9);
      border: 2px solid #204c86;
      border-radius: 16px;
      padding: 14px 22px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .submit-banner {
      background: linear-gradient(90deg, #ff6f00, #ff8f00);
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 10px;
      font-size: 19px;
      font-weight: 900;
      text-align: center;
      letter-spacing: 1px;
      display: none;
    }
    .grading-teams-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
    }
    .team-grade-box {
      flex: 1;
      background: #0c1c3c;
      border: 1.5px solid #285494;
      border-radius: 12px;
      padding: 9px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .grade-team-name {
      font-size: 16px;
      font-weight: 800;
      color: #dbeaff;
    }
    .grade-btns-pair {
      display: flex;
      gap: 8px;
      width: 100%;
    }
    .btn-grade {
      flex: 1;
      padding: 8px 0;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 900;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
    }
    .btn-grade.grade-correct {
      background: #144d2d;
      color: #92e6b2;
      border: 1px solid #1f8249;
    }
    .btn-grade.grade-correct.selected {
      background: #00c853;
      color: #fff;
      box-shadow: 0 0 12px rgba(0, 200, 83, 0.7);
    }
    .btn-grade.grade-wrong {
      background: #4d181e;
      color: #e69299;
      border: 1px solid #82222b;
    }
    .btn-grade.grade-wrong.selected {
      background: #d50000;
      color: #fff;
      box-shadow: 0 0 12px rgba(213, 0, 0, 0.7);
    }

    .modal-actions-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
    }
    .btn-reveal {
      background: linear-gradient(180deg, #ff9800, #e65100);
      border: 2px solid #ffb74d;
      color: #fff;
      font-size: 18px;
      font-weight: 900;
      padding: 11px 26px;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    .btn-unlock-knowledge {
      background: linear-gradient(180deg, #00c853, #009624);
      border: 2px solid #69f0ae;
      color: #ffffff;
      font-size: 19px;
      font-weight: 900;
      padding: 11px 30px;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 0 25px rgba(0, 230, 118, 0.6);
      display: none;
    }
    .btn-finish-q {
      background: linear-gradient(180deg, #1976d2, #0d47a1);
      border: 2px solid #64b5f6;
      color: #fff;
      font-size: 18px;
      font-weight: 900;
      padding: 11px 28px;
      border-radius: 12px;
      cursor: pointer;
      opacity: 0.4;
      pointer-events: none;
    }
    .btn-finish-q.active-ready {
      opacity: 1;
      pointer-events: auto;
      box-shadow: 0 0 20px rgba(33, 150, 243, 0.7);
    }

    /* Modal thẻ đặc biệt */
    .special-card-modal {
      text-align: center;
      padding: 40px 60px;
    }
    .special-title {
      font-size: 44px;
      font-weight: 900;
      margin-bottom: 18px;
    }
    .special-desc {
      font-size: 26px;
      line-height: 1.6;
      color: #e3f2fd;
      margin-bottom: 28px;
      font-weight: 700;
    }
    .steal-targets-row {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 28px;
    }
    .steal-team-btn {
      padding: 14px 28px;
      font-size: 22px;
      font-weight: 900;
      border-radius: 12px;
      cursor: pointer;
      border: 2px solid #fff;
      color: #fff;
      box-shadow: 0 6px 20px rgba(0,0,0,0.6);
    }

    /* Màn hình tổng kết vinh danh */
    .overlay-view {
      position: absolute;
      top: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      background: radial-gradient(circle at center, #091a3d 0%, #030a1c 80%);
      z-index: 200;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px;
    }
    .view-content-box {
      width: 1660px;
      height: 960px;
      background: linear-gradient(180deg, rgba(14, 34, 76, 0.95), rgba(7, 18, 43, 0.98));
      border: 4px solid #2b73d3;
      border-radius: 28px;
      box-shadow: 0 25px 70px rgba(0,0,0,0.95), 0 0 50px rgba(0, 180, 255, 0.3);
      display: flex;
      flex-direction: column;
      padding: 28px 45px;
      position: relative;
    }
    
    .winner-trophy-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
    }
    .trophy-title {
      font-size: 60px;
      font-weight: 900;
      color: #ffeb3b;
      text-shadow: 0 0 25px rgba(255, 235, 59, 0.8), 0 4px 10px rgba(0,0,0,0.9);
      margin-bottom: 18px;
    }
    .winner-names {
      font-size: 46px;
      font-weight: 900;
      color: #ffffff;
      margin-bottom: 32px;
      text-shadow: 0 0 20px rgba(0, 229, 255, 0.8);
    }
    .winner-scores-grid {
      display: flex;
      gap: 30px;
      margin-bottom: 36px;
    }
    .winner-score-card {
      width: 250px;
      background: #091733;
      border: 3px solid #24508c;
      border-radius: 16px;
      padding: 18px;
      text-align: center;
    }

    /* MÀN HÌNH CHỐT KIẾN THỨC CUỐI CÙNG (5 DATA BẤM TỪNG Ý) */
    .knowledge-layout {
      display: flex;
      width: 100%;
      height: 100%;
      gap: 30px;
    }
    .k-left-robot {
      width: 360px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .k-main-display {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      position: relative;
      padding: 10px 0;
    }

    .element-card-3d {
      width: 260px;
      height: 250px;
      background: linear-gradient(135deg, #0e3770 0%, #081d40 100%);
      border: 4px solid #00e5ff;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 40px rgba(0, 229, 255, 0.5), inset 0 0 25px rgba(0, 229, 255, 0.3);
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 10;
    }
    .el-num {
      font-size: 32px;
      font-weight: 900;
      color: #92d9ff;
      position: absolute;
      top: 14px;
      left: 20px;
    }
    .el-symbol {
      font-size: 92px;
      font-weight: 900;
      color: #ffffff;
      text-shadow: 0 0 15px rgba(0, 229, 255, 0.9);
      line-height: 1;
      margin-top: 15px;
    }
    .el-name {
      font-size: 26px;
      font-weight: 800;
      color: #ffeb3b;
      letter-spacing: 2px;
    }

    .knowledge-cards-container {
      width: 100%;
      height: 100%;
      position: relative;
    }
    
    .k-card {
      position: absolute;
      width: 360px;
      height: 275px;
      background: linear-gradient(180deg, #0f2756 0%, #071736 100%);
      border: 3.5px solid #23589b;
      border-radius: 20px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 10px 30px rgba(0,0,0,0.7);
      text-align: center;
      cursor: pointer;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .k-card:hover:not(.revealed) {
      transform: translateY(-6px);
      border-color: #00e5ff;
      box-shadow: 0 14px 35px rgba(0,0,0,0.85), 0 0 25px rgba(0, 229, 255, 0.5);
    }
    .k-card.revealed {
      cursor: default;
      border-color: #00e5ff;
      box-shadow: 0 0 30px rgba(0, 229, 255, 0.35);
      background: linear-gradient(180deg, #10326e 0%, #0a1e42 100%);
    }

    .k-pos-1 { top: 12px; left: 8px; }
    .k-pos-2 { top: 12px; left: 50%; transform: translateX(-50%); }
    .k-pos-3 { top: 12px; right: 8px; }
    .k-pos-4 { bottom: 12px; left: 160px; }
    .k-pos-5 { bottom: 12px; right: 160px; }

    .k-badge-row {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .k-tag {
      font-size: 16px;
      font-weight: 900;
      padding: 4px 14px;
      border-radius: 8px;
      background: #162f55;
      color: #729ad0;
      letter-spacing: 1px;
    }
    .k-card.revealed .k-tag {
      background: #0091ea;
      color: #fff;
      box-shadow: 0 0 10px rgba(0, 145, 234, 0.6);
    }
    .k-status-indicator {
      font-size: 20px;
      font-weight: 900;
      color: #5a7ea8;
    }
    .k-card.revealed .k-status-indicator {
      color: #00e676;
      text-shadow: 0 0 8px rgba(0, 230, 118, 0.7);
    }

    .k-center-area {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .k-unrevealed-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .k-qmark-big {
      font-size: 88px;
      font-weight: 900;
      background: linear-gradient(180deg, #fff3a8 0%, #ffb800 45%, #ff7700 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.8));
    }
    .k-click-prompt {
      font-size: 14px;
      font-weight: 800;
      color: #64b5f6;
      margin-top: 4px;
    }

    .k-revealed-box {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      animation: fadeInK 0.25s ease-out forwards;
    }
    @keyframes fadeInK {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    .k-card.revealed .k-unrevealed-box { display: none; }
    .k-card.revealed .k-revealed-box { display: flex; }

    .k-illustration-box {
      width: 100%;
      height: 130px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .k-title {
      font-size: 21px;
      font-weight: 900;
      color: #ffffff;
      line-height: 1.35;
      margin-top: 6px;
      text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
    }

    .start-screen-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 1920px;
      height: 1080px;
      background: rgba(3, 8, 20, 0.94);
      z-index: 300;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .btn-big-start {
      background: linear-gradient(180deg, #00e5ff 0%, #0091ea 50%, #0064b7 100%);
      border: 4px solid #80d8ff;
      border-radius: 28px;
      padding: 20px 85px;
      font-size: 40px;
      font-weight: 900;
      color: #ffffff;
      cursor: pointer;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8), 0 0 40px rgba(0, 229, 255, 0.8), inset 0 2px 4px rgba(255, 255, 255, 0.6);
      letter-spacing: 2px;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .btn-big-start:hover {
      transform: scale(1.05);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.9), 0 0 60px rgba(0, 229, 255, 1);
    }
    .btn-big-start:active { transform: scale(0.98); }
  </style>
</head>
<body>

  <div id="screen-wrapper">
    <div id="game-stage">

      <div class="lab-background">
        <div class="lab-ceiling"></div>
        <div class="lab-floor">
          <div class="lab-floor-lines"></div>
        </div>
      </div>

      <div class="top-controls">
        <button class="ctrl-btn" id="btn-sound" onclick="toggleSound()">
          <span id="sound-icon">🔊</span> <span id="sound-text">ÂM THANH</span>
        </button>
        <button class="ctrl-btn" onclick="toggleFullScreen()">
          ⛶ TOÀN MÀN HÌNH
        </button>
        <button class="ctrl-btn" style="background: linear-gradient(180deg, #d32f2f, #8b0000); border-color: #ff5252;" onclick="confirmEndGame()">
          🏁 KẾT THÚC TRÒ CHƠI
        </button>
        <button class="ctrl-btn" onclick="resetFullGame()">
          ↻ CHƠI LẠI
        </button>
      </div>

      <div class="brand-container">
        <div class="brand-frame">
          <div class="title-ai">AI Cl-17</div>
          <div class="title-kho">KHO DỮ LIỆU BÍ MẬT</div>
          <div class="title-sub">ỨNG DỤNG CỦA CHLORINE</div>
        </div>
      </div>

      <!-- Scoreboard 4 Nhóm -->
      <div class="scoreboard-row">
        <!-- Nhóm 1 -->
        <div class="team-card team-1" id="team-card-0">
          <div class="team-avatar-box">
            <svg viewBox="0 0 140 48" width="140" height="48">
              <circle cx="45" cy="22" r="16" fill="#ffcdd2" />
              <circle cx="95" cy="22" r="16" fill="#ffcdd2" />
              <path d="M 28 20 C 28 8 62 8 62 20 Z" fill="#212121" />
              <circle cx="40" cy="22" r="2.5" fill="#212121" /><circle cx="50" cy="22" r="2.5" fill="#212121" />
              <path d="M 42 27 Q 45 30 48 27" stroke="#b71c1c" stroke-width="1.8" fill="none" />
              <path d="M 78 20 C 78 8 112 8 112 20 Z" fill="#212121" />
              <circle cx="90" cy="22" r="2.5" fill="#212121" /><circle cx="100" cy="22" r="2.5" fill="#212121" />
              <path d="M 92 27 Q 95 30 98 27" stroke="#b71c1c" stroke-width="1.8" fill="none" />
              <path d="M 25 48 Q 45 34 65 48" fill="#d32f2f" />
              <path d="M 75 48 Q 95 34 115 48" fill="#d32f2f" />
              <polygon points="45,36 42,46 48,46" fill="#fff" />
              <polygon points="95,36 92,46 98,46" fill="#fff" />
            </svg>
          </div>
          <div class="team-badge-header">NHÓM 1</div>
          <div class="team-led-score" id="score-0">0</div>
          <div class="team-adjust-row">
            <button class="adj-btn" onclick="manualScore(0, -10)">-10</button>
            <button class="adj-btn" onclick="manualScore(0, 10)">+10</button>
          </div>
        </div>

        <!-- Nhóm 2 -->
        <div class="team-card team-2" id="team-card-1">
          <div class="team-avatar-box">
            <svg viewBox="0 0 140 48" width="140" height="48">
              <circle cx="45" cy="22" r="16" fill="#e1f5fe" />
              <circle cx="95" cy="22" r="16" fill="#e1f5fe" />
              <path d="M 28 20 C 28 8 62 8 62 20 Z" fill="#37474f" />
              <circle cx="40" cy="22" r="2.5" fill="#212121" /><circle cx="50" cy="22" r="2.5" fill="#212121" />
              <path d="M 42 27 Q 45 30 48 27" stroke="#01579b" stroke-width="1.8" fill="none" />
              <path d="M 78 20 C 78 8 112 8 112 20 Z" fill="#37474f" />
              <circle cx="90" cy="22" r="2.5" fill="#212121" /><circle cx="100" cy="22" r="2.5" fill="#212121" />
              <path d="M 92 27 Q 95 30 98 27" stroke="#01579b" stroke-width="1.8" fill="none" />
              <path d="M 25 48 Q 45 34 65 48" fill="#0288d1" />
              <path d="M 75 48 Q 95 34 115 48" fill="#0288d1" />
              <polygon points="45,36 42,46 48,46" fill="#fff" />
              <polygon points="95,36 92,46 98,46" fill="#fff" />
            </svg>
          </div>
          <div class="team-badge-header">NHÓM 2</div>
          <div class="team-led-score" id="score-1">0</div>
          <div class="team-adjust-row">
            <button class="adj-btn" onclick="manualScore(1, -10)">-10</button>
            <button class="adj-btn" onclick="manualScore(1, 10)">+10</button>
          </div>
        </div>

        <!-- Nhóm 3 -->
        <div class="team-card team-3" id="team-card-2">
          <div class="team-avatar-box">
            <svg viewBox="0 0 140 48" width="140" height="48">
              <circle cx="45" cy="22" r="16" fill="#fffde7" />
              <circle cx="95" cy="22" r="16" fill="#fffde7" />
              <path d="M 28 20 C 28 8 62 8 62 20 Z" fill="#4e342e" />
              <circle cx="40" cy="22" r="2.5" fill="#212121" /><circle cx="50" cy="22" r="2.5" fill="#212121" />
              <path d="M 42 27 Q 45 30 48 27" stroke="#e65100" stroke-width="1.8" fill="none" />
              <path d="M 78 20 C 78 8 112 8 112 20 Z" fill="#4e342e" />
              <circle cx="90" cy="22" r="2.5" fill="#212121" /><circle cx="100" cy="22" r="2.5" fill="#212121" />
              <path d="M 92 27 Q 95 30 98 27" stroke="#e65100" stroke-width="1.8" fill="none" />
              <path d="M 25 48 Q 45 34 65 48" fill="#f57f17" />
              <path d="M 75 48 Q 95 34 115 48" fill="#f57f17" />
              <polygon points="45,36 42,46 48,46" fill="#fff" />
              <polygon points="95,36 92,46 98,46" fill="#fff" />
            </svg>
          </div>
          <div class="team-badge-header">NHÓM 3</div>
          <div class="team-led-score" id="score-2">0</div>
          <div class="team-adjust-row">
            <button class="adj-btn" onclick="manualScore(2, -10)">-10</button>
            <button class="adj-btn" onclick="manualScore(2, 10)">+10</button>
          </div>
        </div>

        <!-- Nhóm 4 -->
        <div class="team-card team-4" id="team-card-3">
          <div class="team-avatar-box">
            <svg viewBox="0 0 140 48" width="140" height="48">
              <circle cx="45" cy="22" r="16" fill="#e8f5e9" />
              <circle cx="95" cy="22" r="16" fill="#e8f5e9" />
              <path d="M 28 20 C 28 8 62 8 62 20 Z" fill="#263238" />
              <circle cx="40" cy="22" r="2.5" fill="#212121" /><circle cx="50" cy="22" r="2.5" fill="#212121" />
              <path d="M 42 27 Q 45 30 48 27" stroke="#1b5e20" stroke-width="1.8" fill="none" />
              <path d="M 78 20 C 78 8 112 8 112 20 Z" fill="#263238" />
              <circle cx="90" cy="22" r="2.5" fill="#212121" /><circle cx="100" cy="22" r="2.5" fill="#212121" />
              <path d="M 92 27 Q 95 30 98 27" stroke="#1b5e20" stroke-width="1.8" fill="none" />
              <path d="M 25 48 Q 45 34 65 48" fill="#2e7d32" />
              <path d="M 75 48 Q 95 34 115 48" fill="#2e7d32" />
              <polygon points="45,36 42,46 48,46" fill="#fff" />
              <polygon points="95,36 92,46 98,46" fill="#fff" />
            </svg>
          </div>
          <div class="team-badge-header">NHÓM 4</div>
          <div class="team-led-score" id="score-3">0</div>
          <div class="team-adjust-row">
            <button class="adj-btn" onclick="manualScore(3, -10)">-10</button>
            <button class="adj-btn" onclick="manualScore(3, 10)">+10</button>
          </div>
        </div>
      </div>

      <div class="turn-status-banner">
        <div class="turn-status-text" id="turn-banner-text">
          🎮 MỜI NHÓM 1 CHỌN THẺ!
        </div>
      </div>

      <!-- Robot Cl-17 bên trái -->
      <div class="robot-area">
        <div class="robot-svg-container">
          <svg viewBox="0 0 420 520" width="400" height="510">
            <ellipse cx="210" cy="380" rx="90" ry="80" fill="url(#grad-body)" stroke="#81d4fa" stroke-width="4" />
            <path d="M 150 340 L 270 340 L 255 420 L 165 420 Z" fill="#0d47a1" opacity="0.15" />
            <rect x="175" y="365" width="70" height="30" rx="8" fill="#001e3d" stroke="#00e5ff" stroke-width="2.5" />
            <text x="210" y="386" fill="#00e5ff" font-size="16" font-weight="900" text-anchor="middle">Cl-17</text>

            <path d="M 285 360 C 330 350 360 310 375 285" fill="none" stroke="#e0f2fe" stroke-width="24" stroke-linecap="round" />
            <path d="M 285 360 C 330 350 360 310 375 285" fill="none" stroke="#0288d1" stroke-width="6" stroke-linecap="round" />
            <circle cx="380" cy="280" r="16" fill="#ffffff" stroke="#0288d1" stroke-width="3" />
            <line x1="380" y1="280" x2="405" y2="260" stroke="#ffffff" stroke-width="10" stroke-linecap="round" />
