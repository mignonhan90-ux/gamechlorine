    const SpecialCardsTypes = [
      { type: 'DOUBLE', title: '⚡ NHÂN ĐÔI ĐIỂM ×2', desc: 'Nhóm chọn thẻ được nhân đôi toàn bộ số điểm hiện tại đang có!' },
      { type: 'STEAL', title: '🔥 CƯỚP 10 ĐIỂM', desc: 'Nhóm chọn thẻ được cướp 10 điểm từ một đội đối thủ bất kỳ!' },
      { type: 'BONUS', title: '🎁 THƯỞNG 10 ĐIỂM', desc: 'Chúc mừng! Nhóm chọn thẻ nhận ngay phần thưởng +10 điểm vào quỹ điểm!' },
      { type: 'LOSE_TURN', title: '⛔ MẤT LƯỢT', desc: 'Rất tiếc! Nhóm chọn thẻ không nhận được điểm và lượt chơi sẽ chuyển cho đội kế tiếp!' }
    ];

    /* BIẾN QUẢN LÝ TRẠNG THÁI GAME */
    let gameScores = [0, 0, 0, 0];
    let currentTeam = 0;
    let knowledgeUnlocked = [false, false, false, false, false];
    let cardsData = [];
    let isGameStarted = false;

    let currentActiveCardIndex = -1;
    let currentQuestionData = null;
    let timerCountdownVal = 10;
    let timerInterval = null;
    let questionGradingState = [null, null, null, null];
    let pendingUnlockDataIndex = -1;
    let currentSpecialCard = null;

    let summaryRevealed = [false, false, false, false, false];

    function setupCardsDeck() {
      const deck = [];
      OfficialQuestions.forEach(q => deck.push({ cardType: 'QUESTION', data: q, opened: false }));
      SpecialCardsTypes.forEach(s => deck.push({ cardType: 'SPECIAL', data: s, opened: false }));

      for (let i = deck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [deck[i], deck[j]] = [deck[j], deck[i]];
      }
      cardsData = deck;
    }

    function initCardsDOM() {
      const grid = document.getElementById('cards-grid');
      grid.innerHTML = '';
      for (let i = 0; i < 12; i++) {
        const numStr = (i + 1).toString().padStart(2, '0');
        const cardElem = document.createElement('div');
        cardElem.className = `game-card card-c${i + 1} ${!isGameStarted ? 'disabled' : ''}`;
        cardElem.id = `card-elem-${i}`;
        cardElem.onclick = () => onCardClicked(i);

        cardElem.innerHTML = `
          <div class="card-num-badge">${numStr}</div>
          <div class="card-center-circle">
            <div class="card-qmark">?</div>
            <div class="card-check-icon">✓</div>
          </div>
          <div class="card-tech-lines">
            <div class="tech-pill"></div>
            <div class="tech-pill"></div>
            <div class="tech-pill"></div>
          </div>
        `;
        grid.appendChild(cardElem);
      }
    }

    function updateScoreboardUI() {
      for (let i = 0; i < 4; i++) {
        const scoreBox = document.getElementById(`score-${i}`);
        const cardBox = document.getElementById(`team-card-${i}`);
        if (scoreBox) scoreBox.textContent = gameScores[i];
        if (cardBox) {
          if (isGameStarted && i === currentTeam) {
            cardBox.classList.add('active-turn');
          } else {
            cardBox.classList.remove('active-turn');
          }
        }
      }
      updateTurnBanner();
    }

    function updateTurnBanner() {
      const bannerText = document.getElementById('turn-banner-text');
      if (!bannerText) return;
      if (!isGameStarted) {
        bannerText.textContent = "🤖 HỆ THỐNG Cl-17 ĐANG CHỜ KHỞI ĐỘNG...";
        return;
      }
      const teamNames = ["NHÓM 1 (ĐỎ)", "NHÓM 2 (XANH DƯƠNG)", "NHÓM 3 (VÀNG)", "NHÓM 4 (XANH LÁ)"];
      bannerText.textContent = `▶ LƯỢT CHỌN THẺ: ${teamNames[currentTeam]}`;
    }

    function manualScore(teamIdx, delta) {
      gameScores[teamIdx] = Math.max(0, gameScores[teamIdx] + delta);
      updateScoreboardUI();
      if (delta > 0) SoundFX.correctDing();
    }

    function passNextTurn() {
      currentTeam = (currentTeam + 1) % 4;
      updateScoreboardUI();
    }

    function initStartGame() {
      initAudio();
      SoundFX.start();
      document.getElementById('start-overlay').style.display = 'none';
      isGameStarted = true;
      document.querySelectorAll('.game-card').forEach(c => c.classList.remove('disabled'));
      updateScoreboardUI();
      const bannerText = document.getElementById('turn-banner-text');
      bannerText.textContent = "🤖 HỆ THỐNG Cl-17 ĐÃ SẴN SÀNG! 🎮 NHÓM 1 – HÃY CHỌN THẺ!";
    }

    function onCardClicked(index) {
      if (!isGameStarted) return;
      const card = cardsData[index];
      if (card.opened) return;

      SoundFX.cardClick();
      currentActiveCardIndex = index;

      if (card.cardType === 'QUESTION') {
        openQuestionModal(card.data, index);
      } else {
        openSpecialCardModal(card.data, index);
      }
    }

    function openQuestionModal(qData, cardIdx) {
      currentQuestionData = qData;
      pendingUnlockDataIndex = qData.targetDataIndex;
      questionGradingState = [null, null, null, null];

      const numStr = (cardIdx + 1).toString().padStart(2, '0');
      document.getElementById('modal-card-label').textContent = `THẺ SỐ ${numStr}`;
      document.getElementById('question-text').textContent = qData.text;

      for (let i = 0; i < 4; i++) {
        const textElem = document.getElementById(`ans-text-${i}`);
        const cardElem = document.getElementById(`ans-card-${i}`);
        textElem.textContent = qData.options[i];
        cardElem.className = 'answer-card';
      }

      clearInterval(timerInterval);
      timerCountdownVal = 10;
      const timerDisplay = document.getElementById('timer-number');
      timerDisplay.textContent = '10';
      timerDisplay.className = 'timer-display';
      document.getElementById('btn-start-timer').disabled = false;

      document.getElementById('submit-notice').style.display = 'none';
      document.getElementById('btn-unlock-data').style.display = 'none';

      for (let i = 0; i < 4; i++) {
        document.getElementById(`g-btn-${i}-true`).classList.remove('selected');
        document.getElementById(`g-btn-${i}-false`).classList.remove('selected');
      }

      const finishBtn = document.getElementById('btn-complete-q');
      finishBtn.classList.remove('active-ready');

      document.getElementById('question-modal').style.display = 'flex';
    }

    /* BỘ ĐẾM 10 GIÂY VỚI HIỆU ỨNG ÂM THANH THEO TỪNG GIAI ĐOẠN */
    function startTimerCountdown() {
      const startBtn = document.getElementById('btn-start-timer');
      startBtn.disabled = true;
      initAudio();

      const timerDisplay = document.getElementById('timer-number');
      clearInterval(timerInterval);

      // Đếm lùi từng giây
      timerInterval = setInterval(() => {
        timerCountdownVal--;
        timerDisplay.textContent = timerCountdownVal;

        if (timerCountdownVal >= 4) {
          // Từ 10 xuống 4: Âm tick đếm giây rõ ràng
          SoundFX.clockTick();
        } else if (timerCountdownVal === 3) {
          // Giây 3: Âm beep vàng cảnh báo
          timerDisplay.className = 'timer-display warn-yellow';
          SoundFX.beep3();
        } else if (timerCountdownVal === 2) {
          // Giây 2: Âm beep cam khẩn trương
          timerDisplay.className = 'timer-display warn-orange';
          SoundFX.beep2();
        } else if (timerCountdownVal === 1) {
          // Giây 1: Âm beep đỏ báo động dồn dập
          timerDisplay.className = 'timer-display warn-red';
          SoundFX.beep1();
        } else if (timerCountdownVal <= 0) {
          // Giây 0: Hết giờ, beeeeep dài
          clearInterval(timerInterval);
          timerDisplay.textContent = '0';
          timerDisplay.className = 'timer-display warn-red';
          SoundFX.timeUpBeeeeep();
          document.getElementById('submit-notice').style.display = 'block';
        }
      }, 1000);
    }

    function revealAnswer() {
      if (!currentQuestionData) return;
      SoundFX.cardClick();

      const correct = currentQuestionData.correctIndex;
      for (let i = 0; i < 4; i++) {
        const cardElem = document.getElementById(`ans-card-${i}`);
        if (i === correct) {
          cardElem.classList.add('correct-highlight');
        } else {
          cardElem.classList.add('wrong-fade');
        }
      }

      const dIdx = currentQuestionData.targetDataIndex;
      const unlockBtn = document.getElementById('btn-unlock-data');
      if (!knowledgeUnlocked[dIdx]) {
        unlockBtn.style.display = 'block';
        unlockBtn.textContent = `🔓 XÁC NHẬN DỮ LIỆU 0${dIdx + 1}`;
        unlockBtn.disabled = false;
      } else {
        unlockBtn.style.display = 'block';
        unlockBtn.textContent = `✓ DỮ LIỆU 0${dIdx + 1} ĐÃ ĐƯỢC XÁC NHẬN`;
        unlockBtn.disabled = true;
      }
    }

    function gradeTeam(teamIndex, isCorrect) {
      const prevResult = questionGradingState[teamIndex];
      if (prevResult === isCorrect) return;

      if (prevResult === true && isCorrect === false) {
        gameScores[teamIndex] = Math.max(0, gameScores[teamIndex] - 10);
      } else if ((prevResult === false || prevResult === null) && isCorrect === true) {
        gameScores[teamIndex] += 10;
        SoundFX.correctDing();
      } else if (prevResult === null && isCorrect === false) {
        SoundFX.wrongBuzz();
      }

      questionGradingState[teamIndex] = isCorrect;
      updateScoreboardUI();

      const btnTrue = document.getElementById(`g-btn-${teamIndex}-true`);
      const btnFalse = document.getElementById(`g-btn-${teamIndex}-false`);
      if (isCorrect) {
        btnTrue.classList.add('selected');
        btnFalse.classList.remove('selected');
      } else {
        btnFalse.classList.add('selected');
        btnTrue.classList.remove('selected');
      }

      const isAllGraded = questionGradingState.every(res => res !== null);
      const finishBtn = document.getElementById('btn-complete-q');
      if (isAllGraded) {
        finishBtn.classList.add('active-ready');
      } else {
        finishBtn.classList.remove('active-ready');
      }
    }

    function confirmUnlockKnowledge() {
      if (pendingUnlockDataIndex < 0 || pendingUnlockDataIndex >= 5) return;
      if (knowledgeUnlocked[pendingUnlockDataIndex]) return;

      knowledgeUnlocked[pendingUnlockDataIndex] = true;
      SoundFX.unlockData();

      const slot = document.getElementById(`slot-${pendingUnlockDataIndex}`);
      if (slot) {
        const dataObj = KnowledgeDatabase[pendingUnlockDataIndex];
        slot.textContent = `✓ ${dataObj.code} ${dataObj.short}`;
        slot.classList.add('unlocked');
      }

      const unlockedCount = knowledgeUnlocked.filter(Boolean).length;
      document.getElementById('unlocked-counter').textContent = `${unlockedCount}/5`;

      const unlockBtn = document.getElementById('btn-unlock-data');
      unlockBtn.textContent = `✓ ĐÃ XÁC NHẬN DỮ LIỆU 0${pendingUnlockDataIndex + 1}`;
      unlockBtn.disabled = true;
    }

    function completeQuestionModal() {
      clearInterval(timerInterval);
      document.getElementById('question-modal').style.display = 'none';

      if (currentActiveCardIndex !== -1) {
        cardsData[currentActiveCardIndex].opened = true;
        const cardElem = document.getElementById(`card-elem-${currentActiveCardIndex}`);
        if (cardElem) cardElem.classList.add('opened');
      }

      passNextTurn();
    }

    function openSpecialCardModal(specialData, cardIdx) {
      currentSpecialCard = specialData;
      SoundFX.special();

      document.getElementById('special-modal-title').textContent = specialData.title;
      document.getElementById('special-modal-desc').textContent = specialData.desc;
      const stealRow = document.getElementById('steal-team-choices');
      const confirmBtn = document.getElementById('btn-special-confirm');

      if (specialData.type === 'STEAL') {
        stealRow.style.display = 'flex';
        stealRow.innerHTML = '';
        confirmBtn.style.display = 'none';

        for (let i = 0; i < 4; i++) {
          if (i !== currentTeam) {
            const btn = document.createElement('button');
            btn.className = 'steal-team-btn';
            const colors = ['#d32f2f', '#0288d1', '#f57f17', '#2e7d32'];
            btn.style.background = colors[i];
            btn.textContent = `NHÓM ${i + 1} (${gameScores[i]} ĐIỂM)`;
            btn.onclick = () => executeStealAction(i);
            stealRow.appendChild(btn);
          }
        }
      } else {
        stealRow.style.display = 'none';
        confirmBtn.style.display = 'block';
      }

      document.getElementById('special-modal').style.display = 'flex';
    }

    function executeStealAction(targetTeamIdx) {
      const targetScore = gameScores[targetTeamIdx];
      if (targetScore <= 0) {
        const desc = document.getElementById('special-modal-desc');
        desc.textContent = "Đội này chưa có điểm để cướp! Hãy chọn đội khác có điểm.";
        return;
      }
      const stealAmount = Math.min(10, targetScore);
      gameScores[targetTeamIdx] -= stealAmount;
      gameScores[currentTeam] += stealAmount;
      SoundFX.correctDing();
      updateScoreboardUI();

      closeSpecialCardModal();
    }

    function confirmSpecialCardAction() {
      if (!currentSpecialCard) return;

      if (currentSpecialCard.type === 'DOUBLE') {
        gameScores[currentTeam] = gameScores[currentTeam] * 2;
        SoundFX.correctDing();
      } else if (currentSpecialCard.type === 'BONUS') {
        gameScores[currentTeam] += 10;
        SoundFX.correctDing();
      } else if (currentSpecialCard.type === 'LOSE_TURN') {
        SoundFX.wrongBuzz();
      }

      updateScoreboardUI();
      closeSpecialCardModal();
    }

    function closeSpecialCardModal() {
      document.getElementById('special-modal').style.display = 'none';

      if (currentActiveCardIndex !== -1) {
        cardsData[currentActiveCardIndex].opened = true;
        const cardElem = document.getElementById(`card-elem-${currentActiveCardIndex}`);
        if (cardElem) cardElem.classList.add('opened');
      }

      passNextTurn();
    }

    function confirmEndGame() {
      initAudio();
      SoundFX.victory();

      for (let i = 0; i < 4; i++) {
        document.getElementById(`end-score-${i}`).textContent = gameScores[i];
      }

      const maxScore = Math.max(...gameScores);
      const winners = [];
      gameScores.forEach((s, idx) => {
        if (s === maxScore && maxScore > 0) winners.push(`NHÓM ${idx + 1}`);
      });

      const winnerNamesElem = document.getElementById('winner-team-names');
      if (winners.length === 0) {
        winnerNamesElem.textContent = "CÁC NHÓM CÙNG CỐ GẮNG Ở VÒNG CHƠI TIẾP THEO!";
      } else if (winners.length === 1) {
        winnerNamesElem.textContent = `XIN CHÚC MỪNG ${winners[0]} XUẤT SẮC DẪN ĐẦU!`;
      } else {
        winnerNamesElem.textContent = `XIN CHÚC MỪNG ${winners.join(' & ')} ĐỒNG CHIẾN THẮNG!`;
      }

      document.getElementById('endgame-view').style.display = 'flex';
    }

    function backToGameFromEndScreen() {
      document.getElementById('endgame-view').style.display = 'none';
    }

    /* MÀN HÌNH CHỐT KIẾN THỨC CUỐI CÙNG */
    function openKnowledgeSummaryScreen() {
      document.getElementById('endgame-view').style.display = 'none';
      summaryRevealed = [false, false, false, false, false];
      renderSummaryUI();
      document.getElementById('knowledge-summary-view').style.display = 'flex';
    }

    function backToGameFromKnowledge() {
      document.getElementById('knowledge-summary-view').style.display = 'none';
    }

    function renderSummaryUI() {
      const revealedCount = summaryRevealed.filter(Boolean).length;
      document.getElementById('k-summary-count').textContent = `${revealedCount}/5`;

      for (let i = 0; i < 5; i++) {
        const cardElem = document.getElementById(`kcard-${i}`);
        const statusElem = document.getElementById(`kstatus-${i}`);
        const tagElem = document.getElementById(`ktag-${i}`);
        const illustElem = document.getElementById(`killust-${i}`);
        const dataObj = KnowledgeDatabase[i];

        if (summaryRevealed[i]) {
          cardElem.classList.add('revealed');
          tagElem.textContent = `${dataObj.code} ✓`;
          statusElem.textContent = '✓';
          illustElem.innerHTML = dataObj.svg;
        } else {
          cardElem.classList.remove('revealed');
          tagElem.textContent = dataObj.code;
          statusElem.textContent = '?';
          illustElem.innerHTML = '';
        }
      }

      const titleElem = document.getElementById('summary-main-title');
      const tipElem = document.getElementById('k-status-tip');
      
      if (revealedCount === 5) {
        titleElem.textContent = "✓ HỒ SƠ KIẾN THỨC HOÀN THÀNH:";
        titleElem.style.color = "#00e676";
        tipElem.textContent = "✓ ĐÃ XÁC NHẬN TOÀN BỘ 5 ỨNG DỤNG QUAN TRỌNG CỦA CHLORINE!";
        tipElem.style.color = "#00ffcc";
      } else {
        titleElem.textContent = "HỒ SƠ KIẾN THỨC:";
        titleElem.style.color = "#ffb800";
        tipElem.textContent = "Giáo viên đặt câu hỏi, sau đó bấm từng DATA để hiển thị kiến thức!";
        tipElem.style.color = "#e0f2fe";
      }
    }

    function revealSummaryCard(index) {
      if (summaryRevealed[index]) return;

      summaryRevealed[index] = true;
      SoundFX.unlockData();
      renderSummaryUI();

      if (summaryRevealed.every(Boolean)) {
        setTimeout(() => {
          SoundFX.dingDingFull();
        }, 300);
      }
    }

    function hideAllSummaryData() {
      summaryRevealed = [false, false, false, false, false];
      SoundFX.cardClick();
      renderSummaryUI();
    }

    /* KHỞI TẠO LẠI TOÀN BỘ GAME */
    function resetFullGame() {
      clearInterval(timerInterval);
      gameScores = [0, 0, 0, 0];
      currentTeam = 0;
      knowledgeUnlocked = [false, false, false, false, false];
      summaryRevealed = [false, false, false, false, false];
      isGameStarted = true;

      document.getElementById('endgame-view').style.display = 'none';
      document.getElementById('knowledge-summary-view').style.display = 'none';
      document.getElementById('question-modal').style.display = 'none';
      document.getElementById('special-modal').style.display = 'none';
      document.getElementById('start-overlay').style.display = 'none';

      for (let i = 0; i < 5; i++) {
        const slot = document.getElementById(`slot-${i}`);
        slot.textContent = `🔒 0${i + 1} ?`;
        slot.className = 'data-slot-item';
      }
      document.getElementById('unlocked-counter').textContent = '0/5';

      setupCardsDeck();
      initCardsDOM();
      updateScoreboardUI();
      fitGameToScreen();
      SoundFX.start();
    }

    window.addEventListener('DOMContentLoaded', () => {
      setupCardsDeck();
      initCardsDOM();
      updateScoreboardUI();
      fitGameToScreen();
    });
  </script>
</body>
</html>
